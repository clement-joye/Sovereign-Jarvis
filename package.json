{
  "name": "second-brain",
  "version": "0.0.0",
  "private": true,
  "description": "Private self-hosted Jarvis personal assistant over Matrix and Pi.",
  "license": "MIT",
  "author": "Clément Joye",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "test": "vitest run",
    "test:integration:postgres": "pnpm --filter @second-brain/integration-tests test:postgres",
    "test:system:compose": "pnpm --filter @second-brain/system-tests test:compose",
    "test:watch": "vitest",
    "test:scripts:checks": "node --test scripts/checks/check-piper-voice.test.mjs scripts/checks/container-image-provenance.test.mjs scripts/checks/dockerfile-base-image-inventory.test.mjs scripts/checks/inventory-container-image-platform.test.mjs scripts/checks/inventory-piper-archives.test.mjs plugins/browser/deploy/install-verified-playwright.test.mjs && node scripts/checks/check-ignored-artifacts.mjs",
    "test:scripts:operator": "node --test scripts/setup/preflight.test.mjs scripts/setup/install-readiness.test.mjs scripts/setup/setup-core.test.mjs scripts/setup/guided-install.test.mjs scripts/matrix/registration.test.mjs scripts/matrix/bootstrap-recovery.test.mjs scripts/operator/jarvis.test.mjs scripts/operator/backup-workspace.test.mjs scripts/service/install-jarvis-boot-service.test.mjs scripts/runtime/update-host-local-runtime-profile.test.mjs",
    "test:measurements": "node --test scripts/measurements/*.test.mjs",
    "test:contract": "vitest run packages/testkit/src/contracts/**/*.contract.test.ts",
    "test:system": "vitest run packages/testkit/src/system-validation.test.ts",
    "arch:check": "dependency-cruiser --config .dependency-cruiser.cjs packages apps",
    "docs:check-links": "node scripts/checks/check-markdown-links.mjs",
    "compose:check": "node scripts/checks/check-compose-config.mjs",
    "deps:check": "node scripts/checks/check-dependency-hygiene.mjs",
    "api:check": "node scripts/checks/check-internal-api-coverage.mjs",
    "api:consistency": "node scripts/checks/check-internal-api-consistency.mjs",
    "observability:check": "node scripts/checks/check-security-observability.mjs",
    "licenses:generate": "node scripts/checks/check-production-licenses.mjs generate",
    "licenses:check": "node --test scripts/checks/check-production-licenses.test.mjs && node scripts/checks/check-production-licenses.mjs check",
    "schema:generate": "node --import tsx packages/contracts/src/generate-json-schema.ts",
    "db:migrate:check": "node --import tsx packages/postgres-adapter/src/check-migrations.ts",
    "db:migrate": "node scripts/migrations/apply-database-migrations.mjs",
    "jarvis:setup": "node scripts/setup/jarvis-setup.mjs",
    "jarvis:start": "node scripts/operator/jarvis.mjs start",
    "jarvis:stop": "node scripts/operator/jarvis.mjs stop",
    "jarvis:status": "node scripts/operator/jarvis.mjs status",
    "jarvis:logs": "node scripts/operator/jarvis.mjs logs",
    "jarvis:update": "node scripts/operator/jarvis.mjs update",
    "jarvis:backup": "node scripts/operator/jarvis.mjs backup",
    "jarvis:backup:workspace": "node scripts/operator/backup-workspace.mjs",
    "jarvis:restore": "node scripts/operator/jarvis.mjs restore",
    "jarvis:delete-deployment": "node scripts/operator/delete-deployment.mjs",
    "jarvis:service:install": "bash scripts/service/install-jarvis-boot-service.sh",
    "jarvis:operator:test": "pnpm test:scripts:operator",
    "runtime:recover": "node scripts/runtime/recover-workspace-runtimes.mjs",
    "measure:buildkit": "node scripts/measurements/measure-buildkit.mjs",
    "agent:new": "node scripts/plugins/create-agent-plugin.mjs",
    "plugin:new": "node scripts/plugins/create-plugin.mjs",
    "plugin:validate": "node --import tsx scripts/plugins/plugin-workflow.mjs validate",
    "plugin:test": "pnpm plugin:validate && vitest run packages/plugin-sdk/src plugins",
    "plugin:docs": "node --import tsx scripts/plugins/plugin-workflow.mjs docs",
    "plugin:docs-check": "node --import tsx scripts/plugins/plugin-workflow.mjs docs-check",
    "plugin:runtime:build": "node --import tsx scripts/plugins/build-plugin-runtime-images.mjs",
    "plugin:retire": "node --import tsx scripts/plugins/plugin-retirement.mjs",
    "platform:release": "node scripts/plugins/plugin-release.mjs",
    "catalog:build": "node --import tsx scripts/plugins/platform-catalog-release.mjs build",
    "catalog:verify": "node --import tsx scripts/plugins/platform-catalog-release.mjs verify",
    "verify": "pnpm typecheck && pnpm test && pnpm test:scripts:checks && pnpm test:scripts:operator && pnpm plugin:validate && pnpm plugin:docs-check && pnpm lint && pnpm format && pnpm docs:check-links && pnpm compose:check && pnpm deps:check && pnpm licenses:check && pnpm api:check && pnpm api:consistency && pnpm observability:check && pnpm arch:check && pnpm test:contract && pnpm schema:generate && pnpm db:migrate:check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
