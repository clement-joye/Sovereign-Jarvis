# TypeScript build artifacts emitted next to source files when tsc is run
# without a proper outDir (see eslint.config.js rootDir/outDir).
**/*.js
**/*.js.map
**/*.d.ts
**/*.d.ts.map
**/*.d.mts
**/*.d.mts.map
**/*.d.cts
**/*.d.cts.map
# Hand-authored module contracts used to typecheck script imports from tests.
!eslint.config.js
!scripts/migrations/*.d.mts
!scripts/operator/*.d.mts
!scripts/setup/test-artifact-fixtures.d.mts
!scripts/runtime/*.d.mts
!scripts/plugins/*.d.mts

# Generated artefacts from `pnpm schema:generate`. The Zod schemas in
# packages/contracts/src/schemas.ts are the source of truth; regenerate
# via `pnpm schema:generate` whenever a schema changes.
docs/generated/*
!docs/generated/PLUGINS.md
!docs/generated/production-dependency-licenses.json
