# Copy to deploy/compose/.env.production and protect it with chmod 600.
# Values marked <...> must be replaced. Keep this file out of Git.

# Required before the production stack starts
POSTGRES_IMAGE=docker.io/library/postgres:16.15-alpine3.24@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
POSTGRES_PASSWORD=<random-secret>
RUNTIME_PROVISIONER_TOKEN=<random-secret>
RUN_AUTHORIZATION_SECRET=<random-secret>
BRAIN_CONTROL_WORKER_COLLABORATION_TOKEN=<random-secret>
RUNTIME_PROFILE_DIR=/absolute/path/to/jarvis-runtime-profile
PLATFORM_CATALOG_DIR=/absolute/path/to/jarvis-platform-catalog
PI_MODEL_PROVIDER_ID=<provider-id>
PI_MODEL_ID=<model-id>
# Leave empty for a credential-free local inference endpoint.
INFERENCE_SERVER_API_KEY=
MATRIX_SERVER_NAME=<stable-tailnet-hostname>

# Required during Matrix bootstrap; disable registration afterwards
CONTINUWUITY_ALLOW_REGISTRATION=false
CONTINUWUITY_REGISTRATION_TOKEN=<temporary-registration-token>

# Required after Matrix bootstrap
MATRIX_ACCESS_TOKEN=<brain-service-account-token>
MATRIX_OWNER_ID=@owner:matrix-server
MATRIX_BRAIN_USER_ID=@brain:matrix-server
MATRIX_E2EE_ENABLED=true
MATRIX_RECOVERY_KEY=<matrix-recovery-key>

# Optional plugin/runtime settings
BRAIN_CONTROL_PLUGIN_ADMIN_TOKEN=<random-secret>
JARVIS_PLUGIN_RUNTIME_CONFIG={}
JARVIS_PLUGIN_CREDENTIALS={}
SCHEDULE_DISPLAY_TIMEZONE=Europe/Stockholm
AGENT_ROOT_CONCURRENCY=1
AGENT_ADMISSION_LEASE_SECONDS=90
AGENT_ADMISSION_HEARTBEAT_SECONDS=30
LOG_LEVEL=info

# Verified media build/runtime inputs
WHISPER_CPP_REVISION=23ee03506a91ac3d3f0071b40e66a430eebdfa1d
WHISPER_CPP_MODEL_ID=ggml-small
WHISPER_CPP_MODEL_SHA256=1be3a9b2063867b937e64e2ec7483364a79917e157fa98c5d94b5c1fffea987b
WHISPER_CPP_MODEL_URL=https://huggingface.co/ggerganov/whisper.cpp/resolve/5359861c739e955e79d9a303bcbc70fb988958b1/ggml-small.bin
WHISPER_CPP_LANGUAGE=auto
PIPER_VERSION=2023.11.14-2
PIPER_MODEL_SHA256=5d4f08ba6a2a48c44592eed3ce56bf85e9de3dd4e20df90541ae68a8310c029a
PIPER_MODEL_CONFIG_SHA256=7e1f4634af596d83cca997fb7a931ba80b70f8a316a2655ee69c55365e0ace14

# Optional private observability overlay
LOKI_IMAGE=<immutable-loki-image>
ALLOY_IMAGE=<immutable-alloy-image>
PROMETHEUS_IMAGE=<immutable-prometheus-image>
GRAFANA_IMAGE=<immutable-grafana-image>
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<random-secret>
DOCKER_LOG_ROOT=/var/lib/docker/containers
GRAFANA_HOST_PORT=3001
PROMETHEUS_HOST_PORT=9091
