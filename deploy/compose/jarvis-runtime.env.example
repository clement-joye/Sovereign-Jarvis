# Copy to deploy/compose/.env.runtime. It is intentionally ignored by Git.
#
# Use absolute paths. This command is run by launchd/systemd, which has a much
# smaller PATH than an interactive shell.
# Any host command that exposes an OpenAI-compatible inference API works here.
INFERENCE_SERVER_COMMAND='/absolute/path/to/inference-server --host 0.0.0.0 --port 8080'

# Optional overrides. The defaults match this repository's production stack.
# JARVIS_COMPOSE_PROJECT=jarvis
# JARVIS_COMPOSE_ENV=/absolute/path/to/Jarvis/deploy/compose/.env.production
# JARVIS_COMPOSE_FILE=/absolute/path/to/Jarvis/deploy/compose/compose.production.yml
