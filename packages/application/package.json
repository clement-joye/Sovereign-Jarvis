{
  "name": "@second-brain/application",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Clément Joye",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./ports": {
